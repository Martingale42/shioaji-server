# Shioaji credentials (required)
SHIOAJI_API_KEY=your_api_key
SHIOAJI_SECRET_KEY=your_secret_key

# CA certificate (required for placing orders).
# Local runs read this path; under Docker it is overridden to /app/Sinopac.pfx via the mount.
CA_PATH=/home/<you>/.shioaji-server/Sinopac.pfx
CA_PERSON=your_ca_password

# Server settings (optional)
# SHIOAJI_SIMULATION=true
# SHIOAJI_SERVER_HOST=0.0.0.0
# SHIOAJI_SERVER_PORT=8000
# SHIOAJI_LOG_LEVEL=info
